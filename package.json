{
  "name": "shepherdconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env server/scripts/bootstrap-admin.js",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "oxfmt": "^0.2.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  }
}
